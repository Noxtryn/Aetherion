{
    "schemaVersion": 1,
    "id": "aetherion",
    "version": "${version}",
    "name": "Aetherion",
    "description": "A modular, animated client interface for Hypixel SkyBlock: the Aurora configuration GUI, a feature framework and a HUD layout editor. Client-side and informational only.",
    "authors": ["Freelocs"],
    "contact": {
        "sources": "https://github.com/Noxtryn/Aetherion"
    },
    "license": "MIT",
    "icon": "assets/aetherion/icon.png",
    "environment": "client",
    "entrypoints": {
        "client": [
            {
                "value": "dev.freelocs.aetherion.core.AetherionMod",
                "adapter": "kotlin"
            }
        ],
        "modmenu": [
            "dev.freelocs.aetherion.core.AetherionModMenuIntegration"
        ]
    },
    "depends": {
        "fabricloader": ">=0.19.5",
        "minecraft": "~${mcTarget}",
        "java": ">=25",
        "fabric-api": "*",
        "fabric-language-kotlin": "*"
    },
    "suggests": {
        "modmenu": "*"
    }
}
